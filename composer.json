{
    "name": "menqz/grid-sortable",
    "description": "Sort the grid data by drag and drop rows",
    "type": "library",
    "keywords": ["menqz", "menqz-admin", "extension", "grid", "sortable"],
    "homepage": "https://github.com/menqz/grid-sortable",
    "license": "MIT",
    "authors": [
        {
            "name": "Menqz",
            "email": "info@menqz.com.br"
        }
    ],
    "require": {
        "php": ">=7.3.0",
        "menqz/menqz-admin": "*",
        "spatie/eloquent-sortable": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "~6.0"
    },
    "autoload": {
        "psr-4": {
            "MenqzAdmin\\Admin\\GridSortable\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MenqzAdmin\\Admin\\GridSortable\\GridSortableServiceProvider"
            ]
        }
    }
}
